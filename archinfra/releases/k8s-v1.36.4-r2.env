CILIUM_VERSION=v1.20.1
CILIUM_CLI_VERSION=v0.19.7
HUBBLE_CLI_VERSION=v1.19.4

# r2 keeps kube-proxy from kubernetes-runtime. A kube-proxy-free profile can be released separately.
CILIUM_KUBE_PROXY_REPLACEMENT=false

