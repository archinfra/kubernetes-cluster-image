# Archinfra Kubernetes application Cluster Image release lock.
# Production builds MUST NOT resolve floating "latest" versions.

RELEASE_VERSION=k8s-v1.36.4-r2
# Canonical/default architecture. Build jobs may explicitly select amd64 or arm64.
TARGET_ARCH=amd64

KUBERNETES_VERSION=1.36.4
KUBERNETES_RUNTIME_IMAGE=ghcr.io/archinfra/kubernetes-runtime/kubernetes-docker:v1.36.4-r2-amd64
